{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato",
    "mode": "dark"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "new_location": "inherit"
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "single": false
  },
  "attention": {
    "sound": true,
    "notifications": true
  },
  "debug": {
    "devtools": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "image_preview": true
  }
}
